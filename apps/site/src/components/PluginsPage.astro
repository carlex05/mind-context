---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { siteCopy, type SiteLocale } from "../i18n/site";
const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const t = siteCopy[locale].plugins;
---

<BaseLayout locale={locale} route="plugins" title={`${t.title} · MindContext — Constellation`} description={t.meta}>
  <div class="content-shell">
    <PageHero eyebrow={t.eyebrow} title={t.hero} description={t.description} />
    <section class="content-grid three">{t.cards.map((card) => <article class="content-card"><span class="feature-icon">{card[0]}</span><h2>{card[1]}</h2><p>{card[2]}</p><small>{card[3]}</small></article>)}</section>
    <section class="prose-section"><h2>{t.principlesTitle}</h2><ul>{t.principles.map((item) => <li>{item}</li>)}</ul></section>
    <section class="plugin-roadmap">{t.phases.map((phase) => <article><span>{phase[0]}</span><h3>{phase[1]}</h3><p>{phase[2]}</p></article>)}</section>
  </div>
</BaseLayout>
