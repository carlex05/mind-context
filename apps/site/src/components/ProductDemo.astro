---
import BrandMark from "./BrandMark.astro";
import { siteCopy, type SiteLocale } from "../i18n/site";

const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const t = siteCopy[locale].home.demo;
const isEs = locale === "es";
---

<div class="mc-demo" data-product-demo data-step="0" aria-label={t.aria}>
  <div class="mc-demo-frame">
    <section class="mc-preauth" data-demo-scene="0">
      <div class="mc-preauth-locale">{isEs ? "ES" : "EN"} ▾</div>
      <div class="mc-preauth-grid">
        <div class="mc-preauth-hero">
          <div class="mc-brand-lockup">
            <BrandMark size={30} />
            <strong>MindContext</strong>
            <span>— Constellation</span>
          </div>
          <span class="mc-eyebrow">
            {isEs
              ? "PRIVACIDAD PRIMERO · MARKDOWN PRIMERO · TUS ARCHIVOS"
              : "PRIVACY-FIRST · MARKDOWN-FIRST · YOUR OWN FILES"}
          </span>
          <h3>{t.storageTitle}</h3>
          <p>{t.storageBody}</p>
          <div class="mc-preauth-actions">
            <span class="mc-primary">{t.localVault}</span>
            <span class="mc-secondary">{t.drive}</span>
          </div>
          <small>✓ {t.storageFootnote}</small>
        </div>
        <aside class="mc-principles">
          <span class="mc-section-label">
            {isEs ? "CONSTRUIDO ALREDEDOR DE TUS DATOS" : "BUILT AROUND YOUR DATA"}
          </span>
          <ul>
            <li>{isEs ? "Tus notas siguen siendo Markdown plano." : "Your notes stay plain Markdown."}</li>
            <li>{isEs ? "Tus archivos viven en almacenamiento bajo tu control." : "Your files live in storage you control."}</li>
            <li>{isEs ? "Conexiones e índices se derivan localmente." : "Connections and indexes are derived locally."}</li>
            <li>{isEs ? "La IA local es una ruta de primera clase." : "Local AI is a first-class path."}</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="mc-workspace" data-demo-scene="workspace">
      <nav class="mc-rail" aria-hidden="true">
        <div class="mc-rail-brand"><BrandMark size={26} /></div>
        <span class="mc-rail-item files active" data-rail-item="files">
          <svg viewBox="0 0 24 24"><path d="M3 6.5h6l2 2H21v9.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M3 9h18"/></svg>
        </span>
        <span class="mc-rail-item search" data-rail-item="search">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        </span>
        <span class="mc-rail-item graph" data-rail-item="graph">
          <svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="7" r="2"/><circle cx="8" cy="18" r="2"/><circle cx="18" cy="17" r="2"/><path d="m8 7 8-.2M7 8l1 8m2-1 6-6m-6 9h6"/></svg>
        </span>
        <span class="mc-rail-item">
          <svg viewBox="0 0 24 24"><path d="M4 4h6l10 10-6 6L4 10Z"/><circle cx="8" cy="8" r="1"/></svg>
        </span>
        <span class="mc-rail-item settings">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 13.5v-3l-2-.6a7 7 0 0 0-.7-1.7l1-1.9-2.1-2.1-1.9 1a7 7 0 0 0-1.7-.7L11 2H8l-.6 2a7 7 0 0 0-1.7.7l-1.9-1-2.1 2.1 1 1.9A7 7 0 0 0 2 9.4l-2 .6v3l2 .6a7 7 0 0 0 .7 1.7l-1 1.9 2.1 2.1 1.9-1a7 7 0 0 0 1.7.7l.6 2h3l.6-2a7 7 0 0 0 1.7-.7l1.9 1 2.1-2.1-1-1.9a7 7 0 0 0 .7-1.8Z" transform="translate(2 1) scale(.83)"/></svg>
        </span>
      </nav>

      <aside class="mc-left-sidebar">
        <div class="mc-sidebar-view" data-sidebar-view="files">
          <header class="mc-sidebar-header">
            <strong>{t.files}</strong>
            <span class="mc-sidebar-actions">＋　⌕　‹</span>
          </header>
          <div class="mc-sidebar-body">
            <div class="mc-tree-row folder"><span>⌄</span><strong>Notes</strong><i>⋯</i></div>
            <div class="mc-tree-row child active"><span></span><strong>RAG.md</strong><i>⋯</i></div>
            <div class="mc-tree-row child"><span></span><strong>MindContext.md</strong><i>⋯</i></div>
            <div class="mc-tree-row child"><span></span><strong>Project.md</strong><i>⋯</i></div>
            <div class="mc-tree-row folder"><span>›</span><strong>Resources</strong><i>⋯</i></div>
            <div class="mc-tree-row folder"><span>›</span><strong>Archive</strong><i>⋯</i></div>
          </div>
        </div>

        <div class="mc-sidebar-view" data-sidebar-view="graph">
          <header class="mc-sidebar-header">
            <strong>{t.graph}</strong>
            <span class="mc-sidebar-actions">‹</span>
          </header>
          <div class="mc-sidebar-body">
            <div class="mc-local-graph">
              <svg viewBox="0 0 250 230" aria-hidden="true">
                <g class="mc-graph-edges">
                  <path d="M55 116 C85 75 115 82 137 108"/>
                  <path d="M137 108 C171 74 197 80 215 101"/>
                  <path d="M137 108 C166 145 192 157 215 174"/>
                  <path d="M55 116 C91 153 111 144 137 108"/>
                </g>
                <g class="mc-graph-dots">
                  <circle cx="55" cy="116" r="7"/>
                  <circle class="active" cx="137" cy="108" r="10"/>
                  <circle cx="215" cy="101" r="7"/>
                  <circle cx="215" cy="174" r="7"/>
                </g>
                <g class="mc-graph-text">
                  <text x="32" y="140">Project</text>
                  <text class="active" x="124" y="135">RAG</text>
                  <text x="176" y="84">MindContext</text>
                  <text x="185" y="198">Local AI</text>
                </g>
              </svg>
            </div>
            <div class="mc-graph-meta">{isEs ? "3 notas conectadas" : "3 connected notes"}</div>
            <div class="mc-connection-row"><span>MindContext</span><small>{isEs ? "Ambas direcciones" : "Both directions"}</small></div>
            <div class="mc-connection-row"><span>Project</span><small>Backlink</small></div>
            <div class="mc-connection-row"><span>Local AI</span><small>{isEs ? "Saliente" : "Outgoing"}</small></div>
          </div>
        </div>

        <div class="mc-sidebar-view" data-sidebar-view="search">
          <header class="mc-sidebar-header">
            <strong>{t.search}</strong>
            <span class="mc-sidebar-actions">‹</span>
          </header>
          <div class="mc-sidebar-body">
            <div class="mc-search-input">
              <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
              <strong>{t.searchQuery}</strong>
              <span>×</span>
            </div>
            <div class="mc-search-meta">{isEs ? "3 resultados · híbrido" : "3 results · hybrid"}</div>
            <div class="mc-search-result selected">
              <strong>RAG</strong><small>{t.resultOne}</small><em>#ai　#knowledge</em>
            </div>
            <div class="mc-search-result">
              <strong>MindContext</strong><small>{t.resultTwo}</small><em>#product</em>
            </div>
            <div class="mc-search-result">
              <strong>Project</strong><small>{t.resultThree}</small><em>#planning</em>
            </div>
          </div>
        </div>
      </aside>

      <section class="mc-main">
        <div class="mc-tabbar">
          <span class="mc-home-tab">
            <svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10M9 20v-6h6v6"/></svg>
          </span>
          <span class="mc-tab active">RAG.md <i>×</i></span>
          <span class="mc-tab">MindContext.md <i>×</i></span>
          <span class="mc-new-tab">+</span>
        </div>

        <header class="mc-view-header">
          <div class="mc-view-nav">
            <span>‹</span><span class="muted">›</span>
          </div>
          <div class="mc-breadcrumb">My Second Brain / Notes / RAG</div>
          <span class="mc-drive-status"><i></i>Drive <b>· {isEs ? "Sincronizado" : "Synced"}</b></span>
          <div class="mc-note-actions">
            <span class="mc-synced">{isEs ? "Sincronizado" : "Synced"}</span>
            <svg viewBox="0 0 24 24"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22Z"/><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22Z"/></svg>
            <svg class="context-active" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
            <svg viewBox="0 0 24 24"><path d="M5 3h12l3 3v15H4V3Z"/><path d="M8 3v6h8V3M8 21v-7h8v7"/></svg>
          </div>
        </header>

        <section class="mc-editor">
          <div class="mc-editor-document">
            <div class="mc-editor-title"># {t.editorHeading}</div>
            <p>
              {t.editorBefore}
              <mark>[[MindContext]]</mark>
              {t.editorAfter}
            </p>
            <p>{isEs ? "El contexto se mantiene cerca de los archivos, no atrapado dentro de la aplicación." : "Context stays close to the files, rather than being trapped inside the application."}</p>
            <div class="mc-editor-list">- [[Project]]<br/>- [[Local AI]]<br/>- #ai #knowledge</div>
            <span class="mc-editor-caret"></span>
          </div>
          <div class="mc-demo-coachmark" data-coachmark="write">
            <span>02</span><strong>{t.steps[1].label}</strong><small>{t.steps[1].body}</small>
          </div>
          <div class="mc-demo-coachmark" data-coachmark="graph">
            <span>03</span><strong>{t.steps[2].label}</strong><small>{t.steps[2].body}</small>
          </div>
          <div class="mc-demo-coachmark" data-coachmark="search">
            <span>04</span><strong>{t.steps[3].label}</strong><small>{t.steps[3].body}</small>
          </div>
        </section>
      </section>

      <aside class="mc-knowledge">
        <h2>RAG</h2>
        <section>
          <h3>{isEs ? "Propiedades" : "Properties"}</h3>
          <span class="mc-chip">#ai</span><span class="mc-chip">#knowledge</span>
        </section>
        <section>
          <h3>{isEs ? "Enlaces" : "Links"}</h3>
          <div class="mc-context-link"><strong>MindContext</strong><small>Notes/MindContext.md</small></div>
          <div class="mc-context-link"><strong>Local AI</strong><small>Notes/Local AI.md</small></div>
        </section>
        <section class="mc-backlinks">
          <h3>Backlinks</h3>
          <div class="mc-context-link"><strong>Project</strong><small>Notes/Project.md</small></div>
          <div class="mc-context-link"><strong>MindContext</strong><small>Notes/MindContext.md</small></div>
        </section>
      </aside>
    </section>
  </div>

  <ol class="mc-demo-stepper">
    {t.steps.map((step, index) => (
      <li>
        <button type="button" data-demo-step={index} aria-current={index === 0 ? "step" : undefined}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step.label}</strong>
          <small>{step.body}</small>
        </button>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll("[data-product-demo]").forEach((demo) => {
    const buttons = Array.from(demo.querySelectorAll("[data-demo-step]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let timer;

    const activate = (index) => {
      current = index;
      demo.setAttribute("data-step", String(index));
      buttons.forEach((button, buttonIndex) => {
        if (buttonIndex === index) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reduced.matches) return;
      timer = window.setInterval(() => activate((current + 1) % buttons.length), 4500);
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        activate(index);
        start();
      });
    });

    demo.addEventListener("mouseenter", stop);
    demo.addEventListener("mouseleave", start);
    demo.addEventListener("focusin", stop);
    demo.addEventListener("focusout", start);
    reduced.addEventListener?.("change", start);
    start();
  });
</script>

<style>
  .mc-demo { position: relative; }

  .mc-demo-frame {
    position: relative;
    height: 610px;
    overflow: hidden;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  .mc-preauth,
  .mc-workspace {
    position: absolute;
    inset: 0;
    transition: opacity .35s ease, transform .35s ease;
  }

  .mc-preauth {
    display: grid;
    padding: 48px;
    place-items: center;
    background: var(--bg);
  }

  .mc-preauth-locale {
    position: absolute;
    top: 18px;
    right: 20px;
    padding: 7px 9px;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    font: 700 .62rem var(--font-mono);
  }

  .mc-preauth-grid {
    display: grid;
    width: min(930px, 100%);
    grid-template-columns: minmax(0, 1.5fr) minmax(250px, .7fr);
    gap: 58px;
    align-items: end;
  }

  .mc-brand-lockup {
    display: flex;
    margin-bottom: 26px;
    gap: 8px;
    align-items: center;
    font-family: var(--font-heading);
  }

  .mc-brand-lockup strong { font-weight: 760; }
  .mc-brand-lockup span { color: var(--ink-muted); }

  .mc-eyebrow,
  .mc-section-label {
    color: var(--ink-muted);
    font-size: .66rem;
    font-weight: 750;
    letter-spacing: .11em;
  }

  .mc-preauth h3 {
    max-width: 620px;
    margin: 14px 0 14px;
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1;
    letter-spacing: -.045em;
  }

  .mc-preauth p {
    max-width: 640px;
    margin: 0 0 24px;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .mc-preauth-actions { display: flex; gap: 9px; margin-bottom: 14px; }

  .mc-primary,
  .mc-secondary {
    display: inline-flex;
    min-height: 44px;
    padding: 0 15px;
    align-items: center;
    border-radius: 10px;
    font-size: .78rem;
    font-weight: 700;
  }

  .mc-primary { color: var(--accent-contrast); background: var(--accent); border: 1px solid var(--accent); box-shadow: 0 8px 24px var(--brand-glow); }
  .mc-secondary { background: var(--surface); border: 1px solid var(--border); }
  .mc-preauth small { color: var(--ink-muted); font-size: .68rem; }

  .mc-principles {
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
  }

  .mc-principles ul { margin: 15px 0 0; padding-left: 18px; }
  .mc-principles li { color: var(--ink-muted); font-size: .74rem; line-height: 1.5; }
  .mc-principles li + li { margin-top: 10px; }

  .mc-workspace {
    display: grid;
    grid-template-columns: 48px 228px minmax(0, 1fr) 235px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    background: var(--editor-surface);
  }

  [data-step="0"] .mc-preauth { opacity: 1; transform: none; }
  [data-step="0"] .mc-workspace { opacity: 0; }
  [data-step="1"] .mc-preauth,
  [data-step="2"] .mc-preauth,
  [data-step="3"] .mc-preauth { opacity: 0; pointer-events: none; transform: translateY(-8px); }
  [data-step="1"] .mc-workspace,
  [data-step="2"] .mc-workspace,
  [data-step="3"] .mc-workspace { opacity: 1; pointer-events: auto; transform: none; }

  .mc-rail {
    z-index: 2;
    display: flex;
    width: 48px;
    padding: 6px 5px;
    flex-direction: column;
    gap: 3px;
    align-items: center;
    background: var(--surface);
    border-right: 1px solid var(--border-soft);
  }

  .mc-rail-brand {
    display: grid;
    width: 36px;
    height: 36px;
    margin-bottom: 4px;
    place-items: center;
    border-bottom: 1px solid var(--border-soft);
  }

  .mc-rail-item {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    color: var(--ink-muted);
    border-radius: 8px;
  }

  .mc-rail-item.settings { margin-top: auto; }

  .mc-rail-item svg,
  .mc-home-tab svg,
  .mc-note-actions svg,
  .mc-search-input svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-step="1"] [data-rail-item="files"],
  [data-step="2"] [data-rail-item="graph"],
  [data-step="3"] [data-rail-item="search"] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  [data-step="2"] [data-rail-item="files"],
  [data-step="3"] [data-rail-item="files"] { color: var(--ink-muted); background: transparent; }

  .mc-left-sidebar {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--surface);
    border-right: 1px solid var(--border-soft);
  }

  .mc-sidebar-view {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity .22s ease;
  }

  [data-step="1"] [data-sidebar-view="files"],
  [data-step="2"] [data-sidebar-view="graph"],
  [data-step="3"] [data-sidebar-view="search"] { opacity: 1; pointer-events: auto; }

  .mc-sidebar-header {
    display: flex;
    height: 42px;
    padding: 0 8px 0 14px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-soft);
    font-size: .72rem;
  }

  .mc-sidebar-header strong { font-weight: 650; }
  .mc-sidebar-actions { color: var(--ink-muted); font-size: .8rem; }
  .mc-sidebar-body { padding: 8px; }

  .mc-tree-row {
    display: grid;
    min-height: 38px;
    padding: 0 7px;
    grid-template-columns: 22px minmax(0, 1fr) 22px;
    gap: 3px;
    align-items: center;
    color: var(--ink);
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: .7rem;
  }

  .mc-tree-row.active {
    background: var(--subtle);
    border-color: var(--border);
  }

  .mc-tree-row.child strong { font-weight: 500; }
  .mc-tree-row i { color: var(--ink-muted); font-style: normal; text-align: center; opacity: .5; }

  .mc-main {
    display: grid;
    min-width: 0;
    grid-template-rows: 35px 39px minmax(0, 1fr);
    background: var(--editor-surface);
  }

  .mc-tabbar {
    display: flex;
    min-width: 0;
    height: 35px;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--border-soft);
  }

  .mc-home-tab {
    display: grid;
    width: 40px;
    min-width: 40px;
    place-items: center;
    color: var(--ink-muted);
    border-right: 1px solid var(--border-soft);
  }

  .mc-home-tab svg { width: 15px; height: 15px; }

  .mc-tab {
    position: relative;
    display: flex;
    width: 145px;
    padding: 0 8px 0 12px;
    align-items: center;
    justify-content: space-between;
    color: var(--ink-muted);
    background: var(--surface);
    border-right: 1px solid var(--border-soft);
    font-size: .68rem;
  }

  .mc-tab.active {
    color: var(--ink);
    background: var(--editor-surface);
    box-shadow: inset 0 2px 0 var(--accent);
  }

  .mc-tab i { color: var(--ink-muted); font-style: normal; }
  .mc-new-tab { display: grid; width: 36px; place-items: center; color: var(--ink-muted); border-right: 1px solid var(--border-soft); }

  .mc-view-header {
    display: grid;
    height: 39px;
    padding: 0 8px;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    gap: 7px;
    align-items: center;
    border-bottom: 1px solid var(--border-soft);
  }

  .mc-view-nav { display: flex; gap: 9px; color: var(--ink-muted); font-size: 1rem; }
  .mc-view-nav .muted { opacity: .25; }
  .mc-breadcrumb { overflow: hidden; color: var(--ink-muted); text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: .62rem; }

  .mc-drive-status {
    display: inline-flex;
    height: 25px;
    padding: 0 8px;
    gap: 4px;
    align-items: center;
    color: var(--sync-ok);
    background: var(--subtle);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    white-space: nowrap;
    font-size: .58rem;
  }

  .mc-drive-status i { width: 6px; height: 6px; background: currentColor; border-radius: 50%; }
  .mc-drive-status b { color: inherit; font-weight: 400; }

  .mc-note-actions { display: flex; gap: 5px; align-items: center; color: var(--ink-muted); }
  .mc-note-actions svg { width: 16px; height: 16px; }
  .mc-note-actions .context-active { color: var(--accent); padding: 4px; box-sizing: content-box; background: var(--accent-soft); border-radius: 6px; }
  .mc-synced { color: var(--sync-ok); font-size: .6rem; }

  .mc-editor {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--editor-surface);
  }

  .mc-editor-document {
    width: min(650px, calc(100% - 42px));
    margin: 0 auto;
    padding: 54px 0 110px;
    color: var(--ink);
    font-size: .78rem;
    line-height: 1.68;
  }

  .mc-editor-title {
    margin-bottom: 24px;
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -.025em;
  }

  .mc-editor-document p { margin: 0 0 16px; }
  .mc-editor-document mark { padding: 2px 4px; color: var(--accent); background: var(--accent-soft); border-radius: 4px; }
