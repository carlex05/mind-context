---
import { siteCopy, type SiteLocale } from "../i18n/site";

const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const t = siteCopy[locale].home.demo;
---

<div class="product-demo" data-product-demo data-step="0" aria-label={t.aria}>
  <div class="demo-window">
    <div class="demo-titlebar">
      <span class="window-dot"></span>
      <span class="window-dot"></span>
      <span class="window-dot"></span>
      <strong>MindContext</strong>
      <span class="demo-vault">My Second Brain</span>
    </div>

    <div class="demo-stage">
      <aside class="demo-sidebar" aria-hidden="true">
        <span class="demo-sidebar-title">▤ {t.files}</span>
        <span>⌂ {t.home}</span>
        <span>⌕ {t.search}</span>
        <span>⌁ {t.graph}</span>
        <div class="demo-tree">
          <span>▾ Notes</span>
          <span class="tree-child">RAG.md</span>
          <span class="tree-child">MindContext.md</span>
          <span class="tree-child">Project.md</span>
        </div>
      </aside>

      <div class="demo-canvas">
        <section class="demo-panel storage-panel" data-demo-panel="0">
          <span class="demo-kicker">01 · {t.steps[0].label}</span>
          <h3>{t.storageTitle}</h3>
          <p>{t.storageBody}</p>
          <div class="storage-choice-grid">
            <article>
              <span class="choice-icon">▱</span>
              <div><strong>{t.localVault}</strong><small>{t.localHint}</small></div>
            </article>
            <article class="choice-active">
              <span class="choice-icon">◫</span>
              <div><strong>{t.drive}</strong><small>{t.driveHint}</small></div>
            </article>
          </div>
          <small class="demo-footnote">✓ {t.storageFootnote}</small>
        </section>

        <section class="demo-panel editor-panel" data-demo-panel="1">
          <div class="editor-demo-tabs">
            <span class="active">RAG.md</span><span>MindContext.md</span>
          </div>
          <div class="editor-demo-content">
            <span class="demo-kicker">02 · {t.steps[1].label}</span>
            <div class="markdown-line heading"># {t.editorHeading}</div>
            <div class="markdown-line">{t.editorBefore} <mark>[[MindContext]]</mark> {t.editorAfter}</div>
            <div class="markdown-line muted">#ai #knowledge</div>
            <div class="cursor-line"><span></span></div>
          </div>
          <aside class="editor-context">
            <span class="demo-kicker">{t.context}</span>
            <strong>{t.backlinks}</strong>
            <span>MindContext.md</span>
            <span>Project.md</span>
          </aside>
        </section>

        <section class="demo-panel graph-panel" data-demo-panel="2">
          <span class="demo-kicker">03 · {t.steps[2].label}</span>
          <div class="graph-copy"><h3>{t.graphTitle}</h3><p>{t.graphBody}</p></div>
          <svg viewBox="0 0 620 330" role="img" aria-label={t.graphAria}>
            <g class="graph-links">
              <path d="M104 182 C188 112 240 128 310 165" />
              <path d="M310 165 C382 116 438 105 514 136" />
              <path d="M310 165 C374 210 416 242 502 252" />
              <path d="M104 182 C196 236 256 224 310 165" />
            </g>
            <g class="graph-nodes">
              <circle cx="104" cy="182" r="10" /><circle cx="310" cy="165" r="14" class="focus" />
              <circle cx="514" cy="136" r="9" /><circle cx="502" cy="252" r="9" />
            </g>
            <g class="graph-labels">
              <text x="74" y="213">Project</text>
              <text x="273" y="198" class="focus-label">RAG</text>
              <text x="477" y="112">MindContext</text>
              <text x="475" y="282">Local AI</text>
            </g>
          </svg>
          <div class="backlink-toast">⌁ {t.backlinkToast}</div>
        </section>

        <section class="demo-panel search-panel" data-demo-panel="3">
          <span class="demo-kicker">04 · {t.steps[3].label}</span>
          <div class="search-demo-box"><span>⌕</span><strong>{t.searchQuery}</strong><kbd>⌘ K</kbd></div>
          <div class="search-results">
            <article><span>RAG.md</span><strong>{t.resultOne}</strong><small>92% · #ai #knowledge</small></article>
            <article><span>MindContext.md</span><strong>{t.resultTwo}</strong><small>86% · #product</small></article>
            <article><span>Project.md</span><strong>{t.resultThree}</strong><small>79% · #planning</small></article>
          </div>
          <div class="demo-outcome"><span>✦</span><div><strong>{t.outcomeTitle}</strong><small>{t.outcomeBody}</small></div></div>
        </section>
      </div>
    </div>
  </div>

  <ol class="demo-stepper">
    {t.steps.map((step, index) => (
      <li>
        <button type="button" data-demo-step={index} aria-current={index === 0 ? "step" : undefined}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step.label}</strong>
          <small>{step.body}</small>
        </button>
      </li>
    ))}
  </ol>
</div>

<script>
  const demos = document.querySelectorAll("[data-product-demo]");

  demos.forEach((demo) => {
    const buttons = Array.from(demo.querySelectorAll("[data-demo-step]"));
    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let timer;

    const activate = (index) => {
      current = index;
      demo.setAttribute("data-step", String(index));
      buttons.forEach((button, buttonIndex) => {
        if (buttonIndex === index) {
          button.setAttribute("aria-current", "step");
        } else {
          button.removeAttribute("aria-current");
        }
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (media.matches) return;
      timer = window.setInterval(() => activate((current + 1) % buttons.length), 4200);
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        activate(index);
        start();
      });
    });

    demo.addEventListener("mouseenter", stop);
    demo.addEventListener("mouseleave", start);
    demo.addEventListener("focusin", stop);
    demo.addEventListener("focusout", start);
    media.addEventListener?.("change", start);
    start();
  });
</script>

<style>
  .product-demo {
    position: relative;
  }

  .demo-window {
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgb(83 111 216 / .12), transparent 20rem),
      rgb(10 15 27 / .94);
    border: 1px solid rgb(122 141 255 / .26);
    border-radius: 20px;
    box-shadow: 0 34px 100px rgb(0 0 0 / .34);
  }

  .demo-titlebar {
    display: flex;
    min-height: 46px;
    padding: 0 16px;
    gap: 7px;
    align-items: center;
    color: #8995ad;
    border-bottom: 1px solid rgb(122 141 255 / .14);
    font-size: .7rem;
  }

  .window-dot {
    width: 8px;
    height: 8px;
    background: #536079;
    border-radius: 50%;
  }

  .window-dot:nth-child(2) { background: #ffb257; opacity: .65; }
  .demo-titlebar strong { margin-left: 6px; color: #dce3f4; }
  .demo-vault { margin-left: auto; font-family: var(--font-mono); }

  .demo-stage {
    display: grid;
    min-height: 430px;
    grid-template-columns: 156px minmax(0, 1fr);
  }

  .demo-sidebar {
    display: flex;
    padding: 18px 12px;
    flex-direction: column;
    gap: 14px;
    color: #7d899f;
    border-right: 1px solid rgb(122 141 255 / .12);
    font-size: .68rem;
  }

  .demo-sidebar-title {
    padding: 8px;
    color: #d7def4;
    background: rgb(83 111 216 / .13);
    border-radius: 7px;
  }

  .demo-tree { display: grid; gap: 8px; margin-top: 6px; }
  .tree-child { padding-left: 17px; color: #9ba6bb; }

  .demo-canvas {
    position: relative;
    min-width: 0;
    min-height: 430px;
  }

  .demo-panel {
    position: absolute;
    inset: 0;
    padding: clamp(26px, 5vw, 54px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px) scale(.99);
    transition: opacity .45s ease, transform .45s ease;
  }

  [data-step="0"] [data-demo-panel="0"],
  [data-step="1"] [data-demo-panel="1"],
  [data-step="2"] [data-demo-panel="2"],
  [data-step="3"] [data-demo-panel="3"] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .demo-kicker {
    color: var(--mc-context-blue);
    font: 700 .66rem/1.4 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .demo-panel h3 {
    margin: 10px 0 8px;
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    letter-spacing: -.035em;
  }

  .demo-panel p { max-width: 620px; color: var(--mc-muted); }

  .storage-choice-grid {
    display: grid;
    max-width: 650px;
    margin: 28px 0 20px;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .storage-choice-grid article {
    display: flex;
    min-height: 112px;
    padding: 18px;
    gap: 14px;
    align-items: center;
    background: rgb(18 24 39 / .72);
    border: 1px solid rgb(122 141 255 / .18);
    border-radius: 13px;
  }

  .storage-choice-grid article.choice-active {
    background: linear-gradient(135deg, rgb(83 111 216 / .15), rgb(18 24 39 / .82));
    border-color: rgb(122 141 255 / .48);
    box-shadow: inset 0 0 28px rgb(83 111 216 / .08);
  }

  .choice-icon {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    color: #a9b7ff;
    background: rgb(83 111 216 / .15);
    border-radius: 10px;
    font-size: 1.15rem;
  }

  .storage-choice-grid strong,
  .storage-choice-grid small { display: block; }
  .storage-choice-grid small { margin-top: 4px; color: var(--mc-muted); line-height: 1.4; }
  .demo-footnote { color: #8f9bb1; }

  .editor-panel { padding: 0; grid-template-columns: minmax(0, 1fr) 180px; }
  [data-step="1"] .editor-panel { display: grid; }

  .editor-demo-tabs {
    position: absolute;
    top: 0;
    right: 180px;
    left: 0;
    display: flex;
    height: 44px;
    align-items: end;
    border-bottom: 1px solid rgb(122 141 255 / .12);
  }

  .editor-demo-tabs span { padding: 10px 16px; color: #7e8aa0; font-size: .68rem; }
  .editor-demo-tabs .active { color: #dce4f6; background: rgb(122 141 255 / .08); border-bottom: 2px solid var(--mc-context-blue); }

  .editor-demo-content { padding: 78px 34px 30px; }
  .markdown-line { margin-top: 18px; color: #c7d0e3; font: .9rem/1.8 var(--font-mono); }
  .markdown-line.heading { color: #ecf0fa; font-size: 1.12rem; }
  .markdown-line.muted { color: #74829a; font-size: .72rem; }
  .markdown-line mark { padding: 2px 5px; color: #aebaff; background: rgb(83 111 216 / .17); border-radius: 5px; }
  .cursor-line { margin-top: 14px; }
  .cursor-line span { display: inline-block; width: 2px; height: 18px; background: var(--mc-context-blue); animation: cursorBlink 1s steps(1) infinite; }

  .editor-context {
    display: flex;
    padding: 22px 16px;
    flex-direction: column;
    gap: 12px;
    color: #9aa6bb;
    border-left: 1px solid rgb(122 141 255 / .12);
    font-size: .7rem;
  }

  .editor-context strong { color: #dbe2f4; margin-top: 8px; }

  .graph-panel { overflow: hidden; }
  .graph-copy { position: relative; z-index: 2; max-width: 430px; }
  .graph-panel svg { position: absolute; right: 2%; bottom: 2%; width: 70%; height: 82%; overflow: visible; }
  .graph-links path { fill: none; stroke: rgb(122 141 255 / .32); stroke-width: 1.5; }
  .graph-nodes circle { fill: var(--mc-context-blue); filter: drop-shadow(0 0 8px rgb(122 141 255 / .5)); }
  .graph-nodes .focus { fill: var(--mc-focus-amber); filter: drop-shadow(0 0 10px rgb(255 178 87 / .6)); }
  .graph-labels text { fill: #9aa7bf; font: 13px var(--font-mono); }
  .graph-labels .focus-label { fill: #ffd19a; }
  .backlink-toast {
    position: absolute;
    right: 7%;
    bottom: 8%;
    padding: 10px 12px;
    color: #cbd4e7;
    background: rgb(10 15 27 / .9);
    border: 1px solid rgb(255 178 87 / .22);
    border-radius: 9px;
    font-size: .7rem;
  }

  .search-demo-box {
    display: flex;
    max-width: 660px;
    margin: 24px 0 16px;
    padding: 13px 15px;
    gap: 10px;
    align-items: center;
    color: #dbe3f5;
    background: rgb(18 24 39 / .82);
    border: 1px solid rgb(122 141 255 / .32);
    border-radius: 11px;
  }

  .search-demo-box kbd { margin-left: auto; color: #7e8aa0; }
  .search-results { display: grid; max-width: 660px; gap: 8px; }
  .search-results article {
    display: grid;
    padding: 12px 14px;
    grid-template-columns: 110px 1fr auto;
    gap: 12px;
    align-items: center;
    background: rgb(18 24 39 / .58);
    border: 1px solid rgb(122 141 255 / .11);
    border-radius: 9px;
  }

  .search-results span { color: #8795ad; font: .66rem var(--font-mono); }
  .search-results strong { font-size: .78rem; }
  .search-results small { color: #73819a; font-size: .62rem; }

  .demo-outcome {
    display: flex;
    max-width: 660px;
    margin-top: 18px;
    padding: 14px;
    gap: 12px;
    align-items: center;
    color: #dce4f4;
    background: rgb(83 111 216 / .1);
    border: 1px solid rgb(122 141 255 / .2);
    border-radius: 10px;
  }

  .demo-outcome > span { color: var(--mc-focus-amber); font-size: 1.15rem; }
  .demo-outcome strong, .demo-outcome small { display: block; }
  .demo-outcome small { margin-top: 3px; color: var(--mc-muted); }

  .demo-stepper {
    display: grid;
    margin: 14px 0 0;
    padding: 0;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    list-style: none;
  }

  .demo-stepper button {
    width: 100%;
    min-height: 108px;
    padding: 14px;
    cursor: pointer;
    text-align: left;
    color: #8a97ae;
    background: rgb(18 24 39 / .44);
    border: 1px solid rgb(122 141 255 / .11);
    border-radius: 11px;
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }

  .demo-stepper button:hover { transform: translateY(-1px); border-color: rgb(122 141 255 / .28); }
  .demo-stepper button[aria-current="step"] { color: #dbe4f5; background: rgb(83 111 216 / .11); border-color: rgb(122 141 255 / .4); }
  .demo-stepper span, .demo-stepper strong, .demo-stepper small { display: block; }
  .demo-stepper span { color: var(--mc-context-blue); font: 700 .62rem var(--font-mono); }
  .demo-stepper strong { margin-top: 7px; font-size: .78rem; }
  .demo-stepper small { margin-top: 5px; color: #78859c; font-size: .66rem; line-height: 1.4; }

  @keyframes cursorBlink { 50% { opacity: 0; } }

  @media (max-width: 820px) {
    .demo-stage { grid-template-columns: 110px minmax(0, 1fr); }
    .demo-sidebar { padding-inline: 9px; }
    .editor-panel { grid-template-columns: minmax(0, 1fr) 140px; }
    .editor-demo-tabs { right: 140px; }
    .search-results article { grid-template-columns: 90px 1fr; }
    .search-results small { display: none; }
  }

  @media (max-width: 680px) {
    .demo-stage { display: block; min-height: 500px; }
    .demo-sidebar { display: none; }
    .demo-canvas { min-height: 500px; }
    .demo-panel { padding: 26px 18px; }
    .storage-choice-grid { grid-template-columns: 1fr; }
    .editor-panel { grid-template-columns: 1fr; }
    .editor-demo-tabs { right: 0; }
    .editor-context { position: absolute; right: 12px; bottom: 16px; width: 150px; min-height: 122px; background: rgb(10 15 27 / .94); border: 1px solid rgb(122 141 255 / .2); border-radius: 9px; }
    .editor-demo-content { padding: 72px 18px 22px; }
    .graph-panel svg { right: -12%; bottom: 5%; width: 105%; height: 67%; }
    .backlink-toast { right: 18px; bottom: 18px; }
    .search-results article { grid-template-columns: 82px 1fr; }
    .demo-stepper { grid-template-columns: repeat(2, 1fr); }
    .demo-stepper button { min-height: 96px; }
  }

  @media (max-width: 420px) {
    .demo-vault { display: none; }
    .demo-canvas, .demo-stage { min-height: 530px; }
    .demo-stepper { grid-template-columns: 1fr; }
    .demo-stepper button { min-height: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-panel { transition: none; }
    .cursor-line span { animation: none; }
  }
</style>
