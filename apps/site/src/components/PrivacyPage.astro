---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { siteCopy, type SiteLocale } from "../i18n/site";
const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const t = siteCopy[locale].privacy;
---

<BaseLayout locale={locale} route="privacy" title={`${t.title} · MindContext — Constellation`} description={t.meta}>
  <div class="content-shell">
    <PageHero eyebrow={t.eyebrow} title={t.hero} description={t.description} />
    <section class="content-grid two">{t.cards.map((card) => <article class="content-card"><h2>{card[0]}</h2><p>{card[1]}</p></article>)}</section>
    <section class="prose-section"><h2>{t.noNeedTitle}</h2><ul>{t.noNeed.map((item) => <li>{item}</li>)}</ul></section>
    <section class="prose-section"><h2>{t.localAiTitle}</h2><p>{t.localAi}</p></section>
    <aside class="callout"><strong>{t.betaTitle}</strong><p>{t.beta}</p></aside>
  </div>
</BaseLayout>
