---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import { siteCopy, sitePath, type SiteLocale } from "../i18n/site";
const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const t = siteCopy[locale].docs;
const base = import.meta.env.BASE_URL;
---

<BaseLayout locale={locale} route="docs" title={`${t.title} · MindContext — Constellation`} description={t.meta}>
  <div class="content-shell">
    <PageHero eyebrow={t.eyebrow} title={t.hero} description={t.description} />
    <section class="docs-index">{t.index.map((item) => <a href={`#${item[3]}`}><span>{item[0]}</span><strong>{item[1]}</strong><small>{item[2]}</small></a>)}</section>
    <section class="prose-section" id="getting-started"><span class="eyebrow">{t.sections.startEyebrow}</span><h2>{t.sections.startTitle}</h2><ol>{t.sections.startItems.map((item) => <li>{item}</li>)}</ol><p><a class="button primary" href={`${base}app/`}>{t.sections.openBeta}</a></p></section>
    <section class="prose-section" id="markdown"><span class="eyebrow">{t.sections.mdEyebrow}</span><h2>{t.sections.mdTitle}</h2><p>{t.sections.mdBody}</p><div class="syntax-grid">{t.sections.syntax.map((item) => <code>{item}</code>)}</div><p>{t.sections.mdBody2}</p></section>
    <section class="prose-section" id="workspace"><span class="eyebrow">{t.sections.workEyebrow}</span><h2>{t.sections.workTitle}</h2><p>{t.sections.workBody}</p><p>{t.sections.workBody2}</p></section>
    <section class="prose-section" id="storage"><span class="eyebrow">{t.sections.storageEyebrow}</span><h2>{t.sections.storageTitle}</h2><p>{t.sections.storageBody}</p><p><a class="text-link" href={sitePath(base, locale, "privacy")}>{t.sections.privacyLink}</a></p></section>
  </div>
</BaseLayout>
