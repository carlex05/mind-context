---
import { siteCopy, type SiteLocale } from "../i18n/site";
const { locale = "en" } = Astro.props as { locale?: SiteLocale };
const t = siteCopy[locale].visual;
---

<div class="constellation-visual" aria-label={t.aria}>
  <svg class="constellation-lines" viewBox="0 0 720 560" aria-hidden="true">
    <defs>
      <radialGradient id="blueGlow"><stop offset="0" stop-color="#7A8DFF" stop-opacity=".7" /><stop offset="1" stop-color="#7A8DFF" stop-opacity="0" /></radialGradient>
      <radialGradient id="amberGlow"><stop offset="0" stop-color="#FFB257" stop-opacity=".72" /><stop offset="1" stop-color="#FFB257" stop-opacity="0" /></radialGradient>
    </defs>
    <ellipse cx="366" cy="278" rx="278" ry="188" class="orbit" />
    <ellipse cx="366" cy="278" rx="212" ry="238" class="orbit orbit-two" />
    <path d="M118 196 C210 120 288 220 360 276 S518 390 620 254" class="connection" />
    <path d="M154 410 C256 340 294 334 360 276 S476 136 574 134" class="connection" />
    <circle cx="118" cy="196" r="36" fill="url(#blueGlow)" />
    <circle cx="574" cy="134" r="34" fill="url(#amberGlow)" />
    <circle cx="154" cy="410" r="30" fill="url(#blueGlow)" />
    <circle cx="620" cy="254" r="30" fill="url(#blueGlow)" />
    <circle cx="360" cy="276" r="48" fill="url(#amberGlow)" />
    <circle cx="118" cy="196" r="7" class="node blue" />
    <circle cx="574" cy="134" r="7" class="node amber" />
    <circle cx="154" cy="410" r="7" class="node blue" />
    <circle cx="620" cy="254" r="7" class="node blue" />
    <circle cx="360" cy="276" r="9" class="node amber" />
  </svg>

  <div class="floating-card card-ideas"><span class="mini-icon">▤</span><div><strong>{t.ideas}</strong><small>{t.ideasBody}</small><em>#capture</em></div></div>
  <div class="floating-card card-connections"><span class="mini-icon">⌁</span><div><strong>{t.connections}</strong><small>{t.connectionsBody}</small><em>#knowledge</em></div></div>
  <div class="floating-card card-knowledge"><span class="mini-icon">◇</span><div><strong>{t.knowledge}</strong><small>{t.knowledgeBody}</small><em>#systems</em></div></div>
  <div class="floating-card card-action"><span class="mini-icon amber-text">↗</span><div><strong>{t.action}</strong><small>{t.actionBody}</small><em>#productivity</em></div></div>

  <div class="app-preview">
    <div class="preview-titlebar"><span></span><span></span><span></span><strong>{t.myNotes}</strong></div>
    <div class="preview-body">
      <aside><b>▤ {t.notes}</b><span>⌘ {t.graph}</span><span>◇ {t.plugins}</span><span>▱ {t.drive}</span></aside>
      <section>
        <div class="preview-search">⌕ {t.search} <kbd>⌘ K</kbd></div>
        <div class="preview-row"><span>{t.rows[0]}</span><em>#knowledge</em></div>
        <div class="preview-row"><span>{t.rows[1]}</span><em>#focus</em></div>
        <div class="preview-row"><span>{t.rows[2]}</span><em>#capture</em></div>
        <div class="preview-row"><span>{t.rows[3]}</span><em>#systems</em></div>
      </section>
    </div>
  </div>
</div>
