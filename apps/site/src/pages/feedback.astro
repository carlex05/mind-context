---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const bugUrl = "https://github.com/carlex05/mind-context/issues/new?template=bug.yml";
const ideaUrl = "https://github.com/carlex05/mind-context/issues/new?template=feature.yml";
const issuesUrl = "https://github.com/carlex05/mind-context/issues";
---

<BaseLayout title="Feedback · MindContext — Constellation" description="Report bugs, suggest improvements and help shape the MindContext public beta.">
  <div class="content-shell">
    <PageHero eyebrow="PUBLIC BETA FEEDBACK" title="Help shape MindContext." description="The beta is intentionally open to real-world feedback. GitHub Issues are the first public feedback channel so every report can be tracked transparently." />

    <section class="feedback-grid">
      <a class="feedback-card" href={bugUrl}>
        <span class="feedback-icon amber-text">!</span>
        <div><h2>Report a bug</h2><p>Something broke, rendered incorrectly, lost state or behaved unexpectedly.</p><strong>Open bug form →</strong></div>
      </a>
      <a class="feedback-card" href={ideaUrl}>
        <span class="feedback-icon">✦</span>
        <div><h2>Suggest an improvement</h2><p>Tell us the problem you are trying to solve and what would make MindContext better.</p><strong>Open idea form →</strong></div>
      </a>
      <a class="feedback-card" href={issuesUrl}>
        <span class="feedback-icon">⌁</span>
        <div><h2>Browse existing feedback</h2><p>Check whether someone has already reported the same bug or proposed a related idea.</p><strong>View issues →</strong></div>
      </a>
    </section>

    <aside class="callout privacy-callout"><strong>Privacy when reporting</strong><p>Do not paste private note contents, Google access tokens, Drive file IDs or personal data into a public issue. The app does not automatically attach note contents to feedback.</p></aside>

    <section class="prose-section">
      <h2>What makes a useful bug report?</h2>
      <ul>
        <li>What you were trying to do.</li>
        <li>What happened and what you expected instead.</li>
        <li>Steps that reproduce the issue.</li>
        <li>Browser and operating system.</li>
        <li>A screenshot only when it contains no private knowledge.</li>
      </ul>
    </section>
  </div>
</BaseLayout>
